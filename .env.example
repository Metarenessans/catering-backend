# ==============================================================================
# ОБЯЗАТЕЛЬНЫЕ СЕРВЕРНЫЕ НАСТРОЙКИ (Инфраструктура)
# ==============================================================================
SECRET_KEY=django-insecure-change-me-in-production-use-strong-random-key
DEBUG=True

# Разрешенные хосты (на проде: chefmil-furshet.ru,www.chefmil-furshet.ru,127.0.0.1,localhost)
ALLOWED_HOSTS=localhost,127.0.0.1

# Подключение к PostgreSQL
DB_NAME=catering_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Разрешенные CORS-источники (на проде: https://chefmil-furshet.ru,https://www.chefmil-furshet.ru)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# ОПЦИОНАЛЬНЫЕ НАСТРОЙКИ (ТЕПЕРЬ УПРАВЛЯЮТСЯ В АДМИНКЕ DJANGO)
#
# Все параметры ниже настраиваются прямо в браузере в разделе:
# Django Admin -> «Настройки системы» (без перезапуска сервера и правки файлов).
# Переменные в .env оставлены только в качестве резервных (fallback).
# ==============================================================================

# 1. Связь с фронтендом (Next.js Revalidation Webhook)
# FRONTEND_URL=http://127.0.0.1:3000
# REVALIDATION_SECRET=catering_schema_secret_key_2026

# 2. Почта (SMTP) для уведомлений о заказах
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=chef-meal@yandex.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=chef-meal@yandex.com

# 3. Интеграция с Telegram
# TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# TG_API_ID=your-api-id
# TG_API_HASH=your-api-hash


